rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow users to access their own data recursively
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Public read for connection testing and system stats
    match /_internal_/{docId} {
      allow read: if true;
    }

    match /system_stats/{docId} {
      allow read: if true;
      // Allow authenticated users to increment counters
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userCount', 'questCount', 'xpTotal']) &&
        (request.resource.data.userCount == resource.data.userCount + 1 || request.resource.data.userCount == resource.data.userCount) &&
        (request.resource.data.questCount >= resource.data.questCount) &&
        (request.resource.data.xpTotal >= resource.data.xpTotal);
      // Admin can do anything
      allow create, delete: if isAuthenticated() && 
        request.auth.token.email == "jayvenkatesanmeenakshi@gmail.com" && 
        request.auth.token.email_verified == true;
    }

    // Admin access
    match /{document=**} {
      allow read, write: if isAuthenticated() && 
        request.auth.token.email == "jayvenkatesanmeenakshi@gmail.com" && 
        request.auth.token.email_verified == true;
    }
  }
}
